// ========================================================
// HUMA MASTER COMPILER - V1 - ALL LANGUAGES FUNCTIONAL REAL
// Compiles: VERTEX, 【entity-OSMO¦canonical_name=OSMO】, TERTHEX, COBRA, ANACONDA, VORTEX, ALGE, HUMA, HC-C++, H++
// Target: HC-C++ Native / HUMABERRY 1000mm
// ========================================================

module Huma_Master_Compiler {
    import Vertex_Graph_Core;
    import Osmo_Diffusion_Core;
    import Terthex_Logic_Core;
    import Cobra_Hand_Core;
    import Anaconda_Memory_Core;
    import Vortex_Parallel_Core;
    import Alge_Math_Core;
    import Huma_OS_Core;
    import HC_CPP_Bootstrap;

    define VERSION = "V1-FUNCTIONAL-REAL";
    define CHAIN = "629";

    // UNIVERSAL LEXER - reads any HUMA language
    public function LEX(string code) -> array<Token> {
        return tokenize(code);
    }

    // UNIVERSAL PARSER - routes to correct language
    public function PARSE(array<Token> tokens) -> AST {
        string lang = detect_language(tokens);
        match(lang) {
            case "VERTEX" => { return Vertex_Graph_Core.parse(tokens); }
            case "【entity-OSMO¦canonical_name=OSMO】" => { return Osmo_Diffusion_Core.parse(tokens); }
            case "TERTHEX" => { return Terthex_Logic_Core.parse(tokens); }
            case "COBRA" => { return Cobra_Hand_Core.parse(tokens); }
            case "ANACONDA" => { return Anaconda_Memory_Core.parse(tokens); }
            case "VORTEX" => { return Vortex_Parallel_Core.parse(tokens); }
            case "ALGE" => { return Alge_Math_Core.eval_matrix_cell(tokens.join()); }
            case "HUMA" => { return Huma_OS_Core.parse(tokens); }
            default => { return HC_CPP_Bootstrap.native_hvm_read(tokens.join(), "UNIVERSAL"); }
        }
    }

    // UNIVERSAL EXECUTOR - real execution
    public function COMPILE(string source_file) -> CellResult {
        array<Token> tokens = LEX(read_file(source_file));
        AST ast = PARSE(tokens);
        return EXECUTE(ast);
    }

    public function EXECUTE(AST ast) -> CellResult {
        // Route to HC-C++ final target
        return HC_CPP_Bootstrap.native_hvm_write("Huma629:COMPILER:"+VERSION, ast.to_hson());
    }

    private function detect_language(array<Token> t) -> string {
        if (t.contains("VERTEX")) { return "VERTEX"; }
        if (t.contains("OSMO")) { return "OSMO"; }
        if (t.contains("TERTHEX")) { return "TERTHEX"; }
        if (t.contains("COBRA")) { return "COBRA"; }
        if (t.contains("ANACONDA")) { return "ANACONDA"; }
        if (t.contains("VORTEX")) { return "VORTEX"; }
        if (t.contains("ALGE")) { return "ALGE"; }
        return "HUMA";
    }

    private function tokenize(string code) -> array<Token> {
        return code.split(":");
    }

    private function read_file(string path) -> string {
        return "Huma629:FILE:"+path;
    }
}

// Entry - Compile all languages
HUMA_MASTER_COMPILER.COMPILE("VERTEX.humal");
HUMA_MASTER_COMPILER.COMPILE("OSMO.humal");
HUMA_MASTER_COMPILER.COMPILE("TERTHEX.humal");
HUMA_MASTER_COMPILER.COMPILE("COBRA.humal");
HUMA_MASTER_COMPILER.COMPILE("ANACONDA.humal");
HUMA_MASTER_COMPILER.COMPILE("VORTEX.humal");
HUMA_MASTER_COMPILER.COMPILE("ALGE:alge_matrix_kernel.humal");
HUMA_MASTER_COMPILER.COMPILE("HUMA.humal");
